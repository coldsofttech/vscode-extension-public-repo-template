{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "types": ["node", "vscode", "mocha"]
  },
  "include": ["src", "test/integration"],
  "exclude": ["node_modules", "dist", ".vscode-test"]
}
